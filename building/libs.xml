<?xml version="1.0" encoding="UTF-8"?>
<libraries checkVersion="update || all">
	<if cond="update || all">
		<print pretty="true">Preparing installation of Codename Engine compatible libraries...</print>
		<!-- Maintained Codename Crew forks, pinned to their legacy branches.
		     The previous HomuHomu833-haxe-stuff URLs no longer resolve. -->
		<git name="hxcpp" url="https://github.com/CodenameCrew/cne-hxcpp" ref="old" />
		<git name="openfl" url="https://github.com/CodenameCrew/cne-openfl" ref="old" skipDeps="true" />
		<git name="lime" url="https://github.com/CodenameCrew/cne-lime" ref="old" skipDeps="true" />
		<git name="flixel" url="https://github.com/CodenameCrew/cne-flixel" ref="old" skipDeps="true" />
		<git name="flixel-addons" url="https://github.com/CodenameCrew/cne-flixel-addons" ref="old" skipDeps="true" />
		<git name="hscript-improved" url="https://github.com/CodenameCrew/hscript-improved" ref="codename-dev" />
		<git name="flxanimate" url="https://github.com/CodenameCrew/cne-flxanimate" ref="earlyFlxAnimatedayslmao" />
		<git name="hxdiscord_rpc" url="https://github.com/CodenameCrew/cne-hxdiscord_rpc" ref="old" skipDeps="true" />
		<git name="hxvlc" url="https://github.com/CodenameCrew/cne-hxvlc" skipDeps="true" />
		<lib name="funkin-modchart" version="1.2.4" skipDeps="true" />
		<git name="away3d" url="https://github.com/CodenameCrew/away3d" ref="old" />
		<lib name="markdown" />
		<lib name="hxcpp-debug-server" />
		<lib name="nape-haxe4" />
		<lib name="format" />
		<lib name="hxp" />
	</if>
</libraries>
